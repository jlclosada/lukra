# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/lukra

# Security
SECRET_KEY=dev-secret-change-in-production-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_NAME=Lukra API
DEBUG=true
CORS_ORIGINS=["http://localhost:5173"]

# Upload
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE=5242880
